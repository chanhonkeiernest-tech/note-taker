const mongo = require('mongoose');
const bcrypt = require("bcryptjs");

const accountschema = new mongo.Schema({
    username: {
        type: String,
        require:true,
        minlength: [1, 'Title cannot be empty'],
        trim: true,
        unique: true 
    },
    password: {
        type: String,
        require:true,
        minlength: [1, 'Password cannot be empty'],
        trim: true,
        unique: true 
    },
    notes: {
        type: String,
        trim: true
    }
});

accountschema.statics.hashing = async function (password) {
  
  return await bcrypt.hash(password, 10);
};

accountschema.methods.passwordCheck = async function (password) {
  
  return await bcrypt.compare(password, this.password);
};


const notedb = mongo.model('account', accountschema);

module.exports = accountdb;